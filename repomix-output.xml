// parser.js
// Responsabilidad única: recibir el texto crudo de un chat exportado de
// WhatsApp y devolver una lista ordenada de mensajes { fecha, autor, texto }.
//
// Está preparado para los distintos formatos que genera WhatsApp según el
// país, el idioma y el sistema (iPhone / Android):
//   Android:  8/7/26, 14:32 - Abel: Hola
//   iPhone:   [8/7/2026, 14:32:05] Abel: Hola
//   12 horas: 8/7/26, 2:32 p. m. - Abel: Hola
//   Separadores de fecha con  /  -  o  .
⋮----
/**
 * Expresión regular que detecta el COMIENZO de un mensaje nuevo.
 *
 * La escribimos en modo legible, parte por parte, y la unimos al final.
 * Cada mensaje empieza siempre por una fecha y una hora; todo lo que venga
 * después (hasta la siguiente fecha) es el contenido, aunque tenga saltos
 * de línea.
 */
⋮----
"\\[?", // iPhone abre con un corchete opcional
"(\\d{1,2})[\\/.\\-](\\d{1,2})[\\/.\\-](\\d{2,4})", // fecha: día mes año
",?\\s+", // coma opcional y espacio(s)
"(\\d{1,2}):(\\d{2})(?::(\\d{2}))?", // hora: hh:mm y segundos opcionales
"\\s*", // espacio opcional antes del am/pm
"([ap]\\.?\\s?m\\.?)?", // am/pm opcional: "am", "p.m.", "p. m."
"\\]?", // iPhone cierra el corchete
"\\s*[-–]?\\s*", // guion separador (Android) opcional
"([^:]+?):\\s", // autor: todo hasta los dos puntos
"([\\s\\S]*)$", // el resto es el texto del mensaje
⋮----
"i" // insensible a mayúsculas (AM / am / Am)
⋮----
/**
 * Convierte las piezas de fecha/hora en un objeto Date real.
 * Normaliza el año de 2 cifras (26 -> 2026) y el formato de 12h.
 *
 * @returns {Date|null} La fecha, o null si no es válida.
 */
function construirFecha(dia, mes, anio, hora, minuto, segundo, meridiano)
⋮----
if (a < 100) a += 2000; // "26" -> 2026
⋮----
if (esPM && h < 12) h += 12; // 2 p. m. -> 14
if (!esPM && h === 12) h = 0; // 12 a. m. -> 00
⋮----
parseInt(mes, 10) - 1, // en JavaScript enero = 0
⋮----
/**
 * Limpia caracteres invisibles que WhatsApp mete al principio de las líneas
 * (marcas de dirección de texto, espacios de ancho cero, etc.) y que
 * romperían la detección de la fecha.
 */
function limpiarLinea(linea)
⋮----
/**
 * Analiza el texto completo del chat y devuelve los mensajes estructurados.
 *
 * @param {string} textoCrudo Contenido tal cual del archivo .txt
 * @returns {{fecha: Date|null, autor: string, texto: string}[]}
 */
export function parsearChat(textoCrudo)
