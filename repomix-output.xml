<file path="exito.html">
<!-- exito.html -->
<!-- El usuario llega aquí DESPUÉS de pagar. Aquí desbloqueamos la descarga. -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>¡Pago completado! · WhatsApp a PDF</title>
  <style>
    :root { color-scheme: light dark; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background: #0b141a;
      color: #e9edef;
    }
    .tarjeta {
      width: 100%;
      max-width: 420px;
      background: #111b21;
      border: 1px solid #2a3942;
      border-radius: 16px;
      padding: 2rem;
      text-align: center;
    }
    .check {
      width: 64px;
      height: 64px;
      margin: 0 auto 1rem;
      border-radius: 50%;
      background: #00a884;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
    }
    h1 { font-size: 1.4rem; margin: 0 0 .5rem; }
    p { color: #8696a0; line-height: 1.5; margin: 0 0 1.5rem; }
    .boton {
      display: inline-block;
      width: 100%;
      padding: .9rem 1rem;
      border: none;
      border-radius: 10px;
      background: #00a884;
      color: #04211a;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
    }
    .boton:hover { background: #06cf9c; }
    .boton:disabled { opacity: .6; cursor: default; }
    .volver { display: inline-block; margin-top: 1rem; color: #53bdeb; font-size: .9rem; }
    .error { color: #f0a5a5; }
  </style>
</head>
<body>
  <main class="tarjeta">
    <div class="check" aria-hidden="true">✓</div>
    <h1>¡Pago completado!</h1>
    <p>Tu PDF ya está listo. Pulsa el botón para descargarlo. Recuerda: todo se ha
       procesado en tu dispositivo, tus mensajes nunca salieron de aquí.</p>

    <button id="descargar" class="boton">Descargar mi PDF</button>
    <a href="/" class="volver">← Volver al inicio</a>
  </main>

  <script>
    // El PDF definitivo (sin marca de agua) se guardó en IndexedDB
    // ANTES de ir a pagar. Aquí lo recuperamos y lo ofrecemos.
    const DB_NOMBRE = 'chatapdf';
    const DB_TIENDA = 'pdfs';
    const PDF_CLAVE = 'pdf-actual';

    function abrirDB() {
      return new Promise((resolve, reject) => {
        const solicitud = indexedDB.open(DB_NOMBRE, 1);
        solicitud.onupgradeneeded = () => {
          if (!solicitud.result.objectStoreNames.contains(DB_TIENDA)) {
            solicitud.result.createObjectStore(DB_TIENDA);
          }
        };
        solicitud.onsuccess = () => resolve(solicitud.result);
        solicitud.onerror = () => reject(solicitud.error);
      });
    }

    function recuperarPDF() {
      return abrirDB().then((db) => new Promise((resolve, reject) => {
        const tx = db.transaction(DB_TIENDA, 'readonly');
        const peticion = tx.objectStore(DB_TIENDA).get(PDF_CLAVE);
        peticion.onsuccess = () => { db.close(); resolve(peticion.result || null); };
        peticion.onerror = () => { db.close(); reject(peticion.error); };
      }));
    }

    const boton = document.getElementById('descargar');

    boton.addEventListener('click', async () => {
      boton.disabled = true;
      const textoOriginal = boton.textContent;
      boton.textContent = 'Descargando…';
      try {
        const blob = await recuperarPDF();
        if (!blob) {
          alert('No encontramos el PDF en este navegador. Vuelve al inicio y genera el chat de nuevo.');
          return;
        }
        const url = URL.createObjectURL(blob);
        const enlace = document.createElement('a');
        enlace.href = url;
        enlace.download = 'chat-whatsapp.pdf';
        enlace.click();
        // Liberamos la memoria un momento después de disparar la descarga.
        setTimeout(() => URL.revokeObjectURL(url), 4000);
      } catch (error) {
        console.error('Error recuperando el PDF:', error);
        alert('Ha ocurrido un error al preparar la descarga. Vuelve al inicio e inténtalo de nuevo.');
      } finally {
        boton.disabled = false;
        boton.textContent = textoOriginal;
      }
    });
  </script>
</body>
</html>
</file>

